{
  "name": "loreines-bay-resort-lodge",
  "version": "1.0.0",
  "description": "Loreine's Bay Resort Lodge — reservation web app (Node.js + PostgreSQL)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "start:production": "node scripts/init-db.js && node src/server.js",
    "dev": "node --watch src/server.js",
    "db:init": "node scripts/init-db.js",
    "setup": "npm run db:init && npm start"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.3",
    "bcrypt": "^5.1.1",
    "connect-pg-simple": "^10.0.0",
    "dotenv": "^16.4.7",
    "ejs": "^3.1.10",
    "express": "^4.21.2",
    "express-session": "^1.18.1",
    "nodemailer": "^6.10.0",
    "pg": "^8.13.1"
  }
}
