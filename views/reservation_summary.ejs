<%- include('partials/header', { title: 'Reservation Summary' }) %>

    <main class="summary-main">
      <div class="summary-card summary-card--wide">
        <h1 class="summary-card__title">Booking confirmed</h1>

        <% if (!reservation) { %>
          <p class="summary-card__empty">No reservation data found. Start from the lodging page.</p>
          <a href="/room_reservation" class="btn btn--primary">Back to booking</a>
        <% } else { %>
          <p class="summary-card__success" role="status">
            Payment successful! Your demo play-money transaction has been processed.
          </p>
          <dl class="summary-details">
            <dt>Reservation ID</dt>
            <dd><%= reservation.reservation_id %></dd>
            <dt>Check-in</dt>
            <dd><%= formatDate(reservation.start_date) %></dd>
            <dt>Check-out</dt>
            <dd><%= formatDate(reservation.end_date) %></dd>
            <dt>Nights</dt>
            <dd><%= reservation.nights || '—' %></dd>
            <dt>Room</dt>
            <dd><%= reservation.room_type %></dd>
            <dt>Total paid</dt>
            <dd><%= reservation.total_price != null ? formatUsd(Number(reservation.total_price)) : '—' %></dd>
            <dt>Status</dt>
            <dd><%= reservation.status %></dd>
            <dt>Payment</dt>
            <dd><%= reservation.payment_status %></dd>
            <% if (typeof playMoneyBalance !== 'undefined') { %>
              <dt>Remaining play balance</dt>
              <dd><%= formatUsd(playMoneyBalance) %></dd>
            <% } %>
            <% if (reservation.notes) { %>
              <dt>Notes</dt>
              <dd><%= reservation.notes %></dd>
            <% } %>
          </dl>
          <% if (user) { %>
            <a href="/my_reservations" class="btn btn--primary">My Reservations</a>
          <% } else { %>
            <a href="/lookup" class="btn btn--primary">Look up reservation</a>
          <% } %>
          <a href="/room_reservation" class="btn btn--outline summary-card__home">Book another stay</a>
        <% } %>
        <a href="/" class="btn btn--outline summary-card__home">Home</a>
      </div>
    </main>

<%- include('partials/footer') %>
