<%- include('partials/header', { title: 'About Us' }) %>

    <section class="hero about-hero" aria-label="About intro">
      <div class="about-hero__inner">
        <h1 class="about-hero__title">Welcome to Loreine's Bay Resort Lodge</h1>
        <p class="about-hero__subtitle">Your luxury getaway in the heart of the San Juan Islands.</p>
      </div>
    </section>

    <div class="about-section">
      <div class="about-item">
        <div class="image-container">
          <img src="https://github.com/BRHackett/Moffat-Bay/blob/main/src/images/landing_header.jpg?raw=true" alt="Loreine's Bay Resort Lodge overview" width="800" height="500" loading="lazy" />
        </div>
        <div class="description">
          <h3>Our Story</h3>
          <p>
            Loreine's Bay Resort Lodge and Marina offers refined dining venues, a heated indoor pool, expansive accommodations, an
            opulent spa, and kid-friendly activities. Our marina facilities ensure a smooth and enjoyable boating trip,
            while the lodge provides a serene escape for visitors looking for adventure and relaxation.
          </p>
        </div>
      </div>

      <div class="about-item">
        <div class="image-container">
          <img src="https://github.com/BRHackett/Moffat-Bay/blob/main/src/images/marina.jpg?raw=true" alt="Marina" width="800" height="500" loading="lazy" />
        </div>
        <div class="description">
          <h3>Our Marina</h3>
          <p>
            Located next to the beautiful Joviedsa Island, our marina is the perfect spot to dock your boat and
            enjoy the natural surroundings. We provide top-notch facilities and services for boaters, ensuring a memorable
            maritime experience.
          </p>
        </div>
      </div>

      <div class="about-item">
        <div class="image-container">
          <img src="https://github.com/BRHackett/Moffat-Bay/blob/main/src/images/dining.jpg?raw=true" alt="Dining experience" width="800" height="500" loading="lazy" />
        </div>
        <div class="description">
          <h3>Fine Dining</h3>
          <p>
            Experience gourmet meals prepared with locally sourced ingredients, all while enjoying breathtaking views of the
            bay. Whether you're celebrating a special occasion or simply enjoying a relaxing meal, our dining venues will
            exceed your expectations.
          </p>
        </div>
      </div>
    </div>

    <section class="call-to-action">
      <h3>
        Immerse yourself in the serenity, luxury, and relaxation at Loreine's Bay Resort Lodge. Book now to experience all we have to
        offer!
      </h3>
      <a href="/room_reservation" class="btn btn--primary">Book Now!</a>
    </section>

<%- include('partials/footer') %>
