<%- include('partials/header', { title: 'Home' }) %>

    <main id="home" class="hero" role="main">
      <div class="hero__overlay hero__overlay--home">
        <h1 class="hero__title">
          <span class="hero__title-accent" tabindex="0">Loreine's Bay Resort Lodge</span>
        </h1>
        <p class="hero__disclaimer">
          Your luxury getaway in the heart of the San Juan Islands. Book your stay and explore everything the bay has to offer.
        </p>
        <div class="hero__demo-cta" aria-label="Live demo booking">
          <p class="hero__demo-cta__title">Try the live demo</p>
          <p class="hero__demo-cta__text">
            Book a room with <strong>$10,000 play money</strong>. Use demo card
            <strong>4111 1111 1111 1111</strong> — no real charges.
          </p>
          <a href="/room_reservation" class="btn btn--primary hero__demo-cta__btn">Book with play money</a>
        </div>
        <p class="hero__text">
          We have something for everyone. Explore our attractions and guided tours, or simply relax on the sandy shores.
          <strong>The choice is yours.</strong>
        </p>
        <a href="/about" class="btn btn--primary">Learn More</a>
      </div>
    </main>

<%- include('partials/footer') %>
