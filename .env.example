PORT=3000
NODE_ENV=development

# Embedded PostgreSQL (no install needed) — default for local development
DATABASE_URL=pglite://./data/loreine

# For Docker/local PostgreSQL instead, use:
# DATABASE_URL=postgresql://loreine:loreine@localhost:5432/loreine_bay

# Session secret — change this in production
SESSION_SECRET=change-me-to-a-long-random-string

# Public app URL (used in confirmation emails)
APP_URL=http://localhost:3000

# Optional SMTP — required to send confirmation emails
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# MAIL_FROM="Loreine's Bay Resort Lodge <your-email@gmail.com>"
